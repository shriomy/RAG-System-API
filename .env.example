# ===========================================================================
# Application
# ===========================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Comma-separated. Your Vite dev server runs on :3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================================================
# Supabase  (Project settings -> API)
# ===========================================================================
SUPABASE_URL=https://poeksuvbkgyxqszcncsr.supabase.co
# service_role key — NEVER expose to the frontend. Bypasses RLS; the backend
# enforces ownership itself via explicit user_id filters.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- JWT verification: pick ONE ---
# (a) Legacy / shared secret projects: Project settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=
# (b) Projects using asymmetric signing keys (ECC/RSA). Leave blank to derive
#     from SUPABASE_URL as <url>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_STORAGE_BUCKET=knowledge_files

# ===========================================================================
# OpenRouter (LLM provider)
# ===========================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fallback only. The real model comes from assistants.model — change the model
# per assistant in the DB, no code change required.
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Sent as HTTP-Referer / X-Title, shows up in OpenRouter's dashboard.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=RAG System API
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# Cheap model used for rolling memory summarisation.
SUMMARY_MODEL=openai/gpt-4o-mini

# ===========================================================================
# Embeddings
# NOTE: OpenRouter has NO embeddings endpoint. Default is local fastembed
# (downloads a ~130MB ONNX model on first use, then no network, no API key).
# providers: fastembed | openai | voyage
# ===========================================================================
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
# Only for EMBEDDING_PROVIDER=openai|voyage
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ===========================================================================
# Qdrant   (docker compose up -d qdrant)
# ===========================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# ===========================================================================
# Ingestion / chunking
# ===========================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25

# ===========================================================================
# Retrieval
# ===========================================================================
RETRIEVAL_TOP_K=5
# Fetched before reranking. With reranker off, CANDIDATE_K is ignored.
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_SCORE_THRESHOLD=
# providers: none | cohere
RERANKER_PROVIDER=none
RERANKER_MODEL=rerank-v3.5
RERANKER_API_KEY=

# ===========================================================================
# Long-term memory
# ===========================================================================
MEMORY_RECENT_MESSAGES=10
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_MAX_CHARS=2000
# Refresh the rolling user summary every N assistant turns.
MEMORY_USER_SUMMARY_EVERY_N_TURNS=3

# ===========================================================================
# Cache  (providers: none | redis)
# ===========================================================================
CACHE_PROVIDER=none
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_NAMESPACE=rag

# ===========================================================================
# Guardrails  (comma-separated names from the guardrail registry)
# ===========================================================================
GUARDRAILS_ENABLED=false
GUARDRAILS=

# ===========================================================================
# Tools / MCP
# ===========================================================================
TOOLS_ENABLED=false
ENABLED_TOOLS=
MCP_ENABLED=false
# JSON map, e.g.
# MCP_SERVERS={"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}}
MCP_SERVERS={}

# ===========================================================================
# Observability (LangSmith)
# ===========================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-system-api
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
